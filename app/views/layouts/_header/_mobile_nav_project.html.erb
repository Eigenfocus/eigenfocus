<ul class="menu w-full px-3 py-1">
  <li class="menu-title flex-row items-center gap-2 min-w-0">
    <%= icon_for(:projects) %>
    <span class="truncate"><%= project.name %></span>
  </li>
  <li>
    <%= link_to project_issues_path(project), class: class_names("min-h-11 content-center", "menu-active": controller_name == 'issues') do %>
      <%= icon_for(:issues) %>
      <span><%= t(:all_issues, scope: :nav) %></span>
    <% end %>
  </li>
  <li>
    <%= link_to visualization_path(project.default_visualization), class: class_names("min-h-11 content-center", "menu-active": controller_name == 'visualizations') do %>
      <%= icon_for(:boards) %>
      <span><%= Visualization.model_name.human %></span>
    <% end %>
  </li>
</ul>
